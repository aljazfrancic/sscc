{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug with gdb (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["--file", "data/examples.txt"],
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Show STL containers and strings in a readable form",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug with the Visual Studio debugger (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["--file", "data/examples.txt"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
